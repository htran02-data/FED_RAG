# No keys are required for offline search with quoted answers.
# Semantic search and optional reranking use Voyage.
VOYAGE_API_KEY=
# Written answers additionally require an Anthropic key and an available model ID.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional alternate directory containing fed.db, vectors.npy, and data/.
# FEDRAG_DATA_DIR=/absolute/path/to/corpus
